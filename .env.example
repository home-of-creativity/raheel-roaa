# Public site URL (used for SEO metadata and Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Maps (server-only). Enable Maps JavaScript API and Maps Embed API, then restrict the key to both.
GOOGLE_API_KEY=

# Optional: use a named Cloudflare tunnel instead of the quick tunnel sidecar.
# Create a tunnel in Cloudflare Zero Trust and set the token here, then swap
# the cloudflared service command in compose.yaml to:
#   tunnel run --token ${CLOUDFLARE_TUNNEL_TOKEN}
# CLOUDFLARE_TUNNEL_TOKEN=
